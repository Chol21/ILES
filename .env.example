# Development Environment Variables
# Copy this file to .env and update with your local values

# Django Settings
DEBUG=True
ENVIRONMENT=development
SECRET_KEY=your-dev-secret-key-change-in-production

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (for development, SQLite is used by default)
# For production, uncomment and configure PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=iles_db
# DB_USER=postgres
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432

# Email Configuration (development uses console backend)
# For production SMTP:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Logging
DJANGO_LOG_LEVEL=INFO
